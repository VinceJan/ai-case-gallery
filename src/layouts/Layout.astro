---
import '../styles/global.css';
import {url,repository} from '../lib/catalog.mjs';
const {title='造物集 · AI Case Gallery',description='把提示词变成可体验的世界。AI 生成作品、原始提示词与每次运行的真实记录。',image}=Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#f3f1ed"/><meta name="description" content={description}/><title>{title}</title><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{image&&<meta property="og:image" content={'https://vincejan.github.io'+image}/>}<link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/></head>
<body><a class="skip-link" href="#main">跳到内容</a>
<header class="site-header"><a class="wordmark" href={url('')} aria-label="造物集首页"><span class="mark">造</span><span>造物集<small>AI CASE GALLERY</small></span></a><nav aria-label="主导航"><a href={url('')} class:list={{active:Astro.url.pathname===url('')}}>作品</a><a href={url('prompts/')} class:list={{active:Astro.url.pathname.includes('/prompts/')}}>提示词</a><a href={url('about/')}>关于与收录</a><a href={repository} target="_blank" rel="noopener" class="repo-link">源码仓库 <span aria-hidden="true">↗</span></a></nav></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div><a href={url('')}>造物集</a><p>保留每一次尝试，也保留生成它的条件。</p></div><div class="footer-links"><a href={url('about/')}>收录方式</a><a href={repository} target="_blank" rel="noopener">GitHub ↗</a><span>持续收录中 · 2026</span></div></footer>
</body></html>
