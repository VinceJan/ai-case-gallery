---
import {caseUrl,imageUrl,labels,playable,url} from '../lib/catalog.mjs';
const {c,index=0}=Astro.props;
---
<article class="work-card" data-card data-topic={c.topic} data-model={c.model} data-harness={c.harness} data-status={playable(c)?'playable':'materials'} data-search={`${c.title} ${c.model} ${c.harness} ${c.topicLabel} ${c.promptVariant}`}>
<a href={caseUrl(c)} class="card-image" aria-label={`查看 ${c.title}`}>
{c.cover?<img src={imageUrl(c)} alt={c.title+'的场景截图'} loading={index<3?'eager':'lazy'} width="1500" height="900"/>:<div class="no-cover"><span>{c.topicLabel}</span><small>本次运行仅留有材料</small></div>}
<span class="card-kind">{c.topicLabel}</span><span class="card-open" aria-hidden="true">↗</span>
</a><div class="card-body"><div class="card-kicker"><span>{c.harness}</span><span class:list={{'status-dot':true,muted:!playable(c)}}>{labels[c.status]||'仅有材料'}</span></div><h3><a href={caseUrl(c)}>{c.title}</a></h3><p class="card-model">{c.model}</p><div class="card-bottom"><span>{c.promptHash?c.promptVariant:'提示词未记录'}</span><label class="compare-choice"><input type="checkbox" data-compare value={c.id} aria-label={`比较 ${c.title}`}/> 加入对比</label></div></div>
</article>
