---
import Layout from '../layouts/Layout.astro';
import {url} from '../lib/catalog.mjs';
---
<Layout title="并排查看 · 造物集"><div class="page"><div class="breadcrumb"><a href={url('')}>作品集</a><span>/</span><span>并排查看</span></div><p class="eyebrow">SIDE BY SIDE</p><h1 class="page-title">放在一起，慢慢看。</h1><p class="page-lead">比较画面、生成条件与实际提示词。每个作品独立加载，避免多个 3D 场景同时运行。</p><div id="comparison" class="compare-grid"></div><p id="comparison-notice" class="compare-notice" hidden>提示词、模型或 harness 条件存在差异。这是具体运行的对照，不能据此单独归因于模型。</p><div id="comparison-empty" class="compare-empty" hidden><p>从作品集勾选 2–3 个作品，即可并排查看。</p><a class="button dark" href={url('')}>返回作品集 ↗</a></div><section id="prompt-difference" hidden class="prompt-section"><h2>提示词差异 · 前两个作品</h2><p id="diff-summary" class="page-lead"></p><pre class="prompt-text" id="diff-text"></pre></section></div>
<script>
const base='/ai-case-gallery/';const esc=(s:string)=>s.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');const labels:Record<string,string>={verified:'已验证展示',built:'构建通过',materials:'仅有材料','build-failed':'构建未通过','runtime-failed':'运行有问题'};
async function start(){try{const all=await fetch(base+'generated/catalog.json').then(r=>r.json());const ids=(new URLSearchParams(location.search).get('runs')||'').split(',').slice(0,3);const records=ids.map(id=>all.find((c:any)=>c.id===id)).filter(Boolean);if(records.length<2){(document.querySelector('#comparison-empty') as HTMLElement).hidden=false;return;}const container=document.querySelector<HTMLElement>('#comparison')!;container.style.gridTemplateColumns=`repeat(${records.length},minmax(0,1fr))`;const texts=await Promise.all(records.map((c:any)=>c.promptHash?fetch(base+'generated/prompts/'+c.id+'.md').then(r=>r.text()):Promise.resolve(null)));
container.innerHTML=records.map((c:any,i:number)=>`<article class="compare-item">${c.cover?`<img src="${base}generated/media/${esc(c.id)}/${esc(c.cover)}" alt="${esc(c.title)}的实际截图"/>`:'<div class="no-cover" style="aspect-ratio:16/10"><span>仅有材料</span></div>'}<div class="compare-item-body"><h2><a href="${base}cases/${esc(c.id)}/">${esc(c.title)}</a></h2><p>${esc(c.description)}</p><dl class="metadata"><div><dt>模型</dt><dd>${esc(c.model)}</dd></div><div><dt>Harness</dt><dd>${esc(c.harness)}</dd></div><div><dt>提示词</dt><dd>${esc(c.promptVariant)}${c.promptHash?' · '+c.promptHash.slice(0,8):' · 未记录'}</dd></div><div><dt>展示状态</dt><dd>${labels[c.status]}</dd></div><div><dt>模型归属依据</dt><dd>${esc(c.modelEvidence)}</dd></div></dl><a class="button dark" href="${base}cases/${esc(c.id)}/">查看作品 ↗</a>${texts[i]!==null?`<details class="prompt-detail"><summary>实际提示词全文</summary><pre class="prompt-text">${esc(texts[i])}</pre></details>`:''}</div></article>`).join('');(document.querySelector('#comparison-notice') as HTMLElement).hidden=false;
const section=document.querySelector<HTMLElement>('#prompt-difference')!;section.hidden=false;const summary=document.querySelector('#diff-summary')!;const diff=document.querySelector('#diff-text')!;if(texts[0]===null||texts[1]===null){summary.textContent='其中一个作品没有找到实际提示词，无法进行文本对照。';(diff as HTMLElement).hidden=true;return;}if(texts[0]===texts[1]){summary.textContent='两个作品使用完全相同的提示词原文。';(diff as HTMLElement).hidden=true;return;}summary.textContent='− 为第一个作品中的文本，+ 为第二个作品中的文本；以下按行显示变化。';const a=texts[0].replaceAll('\r\n','\n').split('\n'),b=texts[1].replaceAll('\r\n','\n').split('\n');const dp=Array.from({length:a.length+1},()=>new Uint16Array(b.length+1));for(let i=a.length-1;i>=0;i--)for(let j=b.length-1;j>=0;j--)dp[i][j]=a[i]===b[j]?1+dp[i+1][j+1]:Math.max(dp[i+1][j],dp[i][j+1]);let i=0,j=0,out=[];while(i<a.length||j<b.length){if(i<a.length&&j<b.length&&a[i]===b[j]){i++;j++;}else if(j<b.length&&(i===a.length||dp[i][j+1]>=dp[i+1][j]))out.push('+ '+b[j++]);else out.push('− '+a[i++]);}diff.textContent=out.join('\n');
}catch{(document.querySelector('#comparison-empty') as HTMLElement).hidden=false;document.querySelector('#comparison-empty p')!.textContent='案例数据未加载成功，请刷新后重试。';}}
start();
</script></Layout>
