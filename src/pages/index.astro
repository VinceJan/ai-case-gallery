---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import {cases,sorted,url,caseUrl,imageUrl,playable} from '../lib/catalog.mjs';
const featured=cases.find(c=>c.id==='konbini-space-bunny-pi')||sorted.find(c=>c.cover);
const groups=[['all','全部作品'],['sakura-town','樱花小镇'],['castle','城堡与农田'],['konbini','雨夜便利店'],['mountain','体素山川'],['minecraft','方块世界']];const topicCount=new Set(cases.map(c=>c.topic)).size;
const models=[...new Set(cases.map(c=>c.model))].sort();const harnesses=[...new Set(cases.map(c=>c.harness))].sort();
---
<Layout>
<section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="tiny-square"></span> AN OPEN COLLECTION OF AI-MADE WORLDS</p><h1>从一句提示词，<br/>到一个<span class="serif-em">可体验的世界。</span></h1><p class="hero-description">小镇、雨夜街角、微缩领地与方块山川。<br/>这里收藏不同模型与工具的创作结果，<br/>也留下每一次尝试的提示词与过程。</p><a class="text-link" href="#collection">进入作品集 <span>↓</span></a><div class="hero-meta"><strong>{cases.length}</strong><span>次运行记录</span><span class="meta-line"></span><strong>{topicCount}</strong><span>类场景实验</span></div></div><a class="hero-work" href={caseUrl(featured)}>{featured.cover?<img src={imageUrl(featured)} alt="雨夜便利店，明亮橱窗映照湿润街角" width="1500" height="900" fetchpriority="high"/>:<div class="hero-placeholder">正在整理作品</div>}<div class="hero-caption"><div><span>FEATURED WORLD / 雨夜街角</span><h2>灯光亮着，雨还在下。</h2><p>{featured.model} <span>·</span> {featured.harness}</p></div><span class="hero-arrow" aria-hidden="true">↗</span></div></a></section>
<section class="collection" id="collection"><div class="section-heading"><div><p class="eyebrow">THE COLLECTION</p><h2>每一次生成，都有自己的样子。</h2></div><p><span id="result-count">{cases.length}</span> 个结果 / 持续收录</p></div>
<div class="topic-tabs" role="group" aria-label="按场景筛选">{groups.map(([value,label])=><button data-topic-filter={value} class:list={{selected:value==='all'}} aria-pressed={value==='all'}>{label}<span>{value==='all'?cases.length:cases.filter(c=>c.topic===value).length}</span></button>)}</div>
<div class="filter-row"><label class="search-box"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="搜索作品、模型或提示词…" aria-label="搜索作品"/></label><div class="selects"><label><span class="sr-only">模型</span><select id="model-filter"><option value="all">全部模型</option>{models.map(m=><option value={m}>{m}</option>)}</select></label><label><span class="sr-only">Harness</span><select id="harness-filter"><option value="all">全部 Harness</option>{harnesses.map(h=><option value={h}>{h}</option>)}</select></label><label><span class="sr-only">展示状态</span><select id="status-filter"><option value="all">全部状态</option><option value="playable">可在线体验</option><option value="materials">仅材料 / 待验证</option></select></label></div></div>
<div class="work-grid">{sorted.map((c,i)=><Card c={c} index={i}/>)}</div><div id="empty-state" hidden><h3>没有找到对应作品。</h3><p>换一个关键词，或清除筛选条件。</p><button id="reset-filters" class="button">清除筛选</button></div>
</section>
<aside class="collection-note"><span class="note-symbol">*</span><p>这些作品记录的是具体一次运行。提示词、工具和配置会影响结果；你可以查看生成条件，再决定如何比较。</p><a href={url('about/')}>了解这份收藏 ↗</a></aside>
<div class="compare-tray" id="compare-tray" hidden><p>已选 <strong id="compare-count">0</strong> 个作品 <span>最多 3 个</span></p><div><button id="clear-compare">清空</button><a class="button dark" id="compare-go" href={url('compare/')}>并排查看 ↗</a></div><span id="compare-message" role="status"></span></div>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('[data-card]')];let topic='all';const search=document.querySelector<HTMLInputElement>('#search')!;const model=document.querySelector<HTMLSelectElement>('#model-filter')!;const harness=document.querySelector<HTMLSelectElement>('#harness-filter')!;const status=document.querySelector<HTMLSelectElement>('#status-filter')!;
function filter(){const q=search.value.trim().toLowerCase();let count=0;for(const card of cards){const visible=(topic==='all'||card.dataset.topic===topic)&&(model.value==='all'||card.dataset.model===model.value)&&(harness.value==='all'||card.dataset.harness===harness.value)&&(status.value==='all'||card.dataset.status===status.value)&&(!q||card.dataset.search?.toLowerCase().includes(q));card.hidden=!visible;if(visible)count++;}document.querySelector('#result-count')!.textContent=String(count);(document.querySelector('#empty-state') as HTMLElement).hidden=count>0;}
document.querySelectorAll<HTMLButtonElement>('[data-topic-filter]').forEach(b=>b.addEventListener('click',()=>{topic=b.dataset.topicFilter!;document.querySelectorAll('[data-topic-filter]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b));});filter();}));[search,model,harness,status].forEach(x=>x.addEventListener(x===search?'input':'change',filter));document.querySelector('#reset-filters')?.addEventListener('click',()=>{topic='all';search.value='';model.value=harness.value=status.value='all';document.querySelector<HTMLButtonElement>('[data-topic-filter="all"]')?.click();filter();});const initialTopic=new URLSearchParams(location.search).get('topic');if(initialTopic)document.querySelector<HTMLButtonElement>(`[data-topic-filter="${CSS.escape(initialTopic)}"]`)?.click();
const selected=new Set<string>();const tray=document.querySelector<HTMLElement>('#compare-tray')!;const checks=[...document.querySelectorAll<HTMLInputElement>('[data-compare]')];function compare(){tray.hidden=!selected.size;document.querySelector('#compare-count')!.textContent=String(selected.size);const go=document.querySelector<HTMLAnchorElement>('#compare-go')!;go.href='/ai-case-gallery/compare/?runs='+[...selected].join(',');go.setAttribute('aria-disabled',String(selected.size<2));}
checks.forEach(c=>c.addEventListener('change',()=>{if(c.checked&&selected.size>=3){c.checked=false;document.querySelector('#compare-message')!.textContent='最多同时比较 3 个作品';return;}c.checked?selected.add(c.value):selected.delete(c.value);document.querySelector('#compare-message')!.textContent='';compare();}));document.querySelector('#clear-compare')?.addEventListener('click',()=>{selected.clear();checks.forEach(c=>c.checked=false);compare();});document.querySelector('#compare-go')?.addEventListener('click',e=>{if(selected.size<2){e.preventDefault();document.querySelector('#compare-message')!.textContent='再选一个作品即可比较';}});
</script>
</Layout>
