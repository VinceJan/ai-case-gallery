{
  "name": "ai-case-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-site.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "doctor": "node scripts/doctor.mjs",
    "spec": "node scripts/make-spec.mjs",
    "intake": "node scripts/intake-case.mjs",
    "discard": "node scripts/discard-candidate.mjs",
    "import": "node scripts/import-case.mjs",
    "rebuild": "node scripts/build-demo.mjs",
    "verify:new": "node scripts/verify-new.mjs",
    "review": "node scripts/review-case.mjs",
    "promote": "node scripts/promote-case.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/*.test.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:cloud": "node scripts/verify-cloud.mjs",
    "clean": "node scripts/clean-work.mjs --all"
  },
  "dependencies": {
    "astro": "7.3.5",
    "esbuild": "0.25.10",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
